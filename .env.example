# dwfinance settings. `npm run setup` creates a working .env for you; copy this file only if you want to set things by hand.

# Where your transactions are stored: one local SQLite file. Nothing leaves this computer.
DATABASE_URL="file:./dev.db"

# Secret used to sign the login cookie. Any random string of 16+ characters; setup generates one.
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: the local AI (Ask AI, and reading statements from banks other than DBS/POSB) runs in LM Studio.
# Default is LM Studio's own address; change it only if you moved the server.
# LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"

# Optional: which account the "Fast access" button opens (development mode only).
# FAST_ACCESS_EMAIL=demo@dwfinance.local
