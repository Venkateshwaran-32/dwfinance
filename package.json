    "gen:sample2067": "tsx scripts/gen-sample-2067.ts",
    "load:demo2067": "tsx --tsconfig scripts/tsconfig.json scripts/load-demo-2067.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && next build",
    "setup": "node scripts/setup.mjs",
    "app": "node scripts/start.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
